// A static marketing site with media. Cache rules are edge configuration
// compiled onto whichever CDN is chosen; they also make
// the `cache` feature a hard requirement, so only edge offers qualify.

workload marketing {
  profile = cheapest

  service www : frontend-static {
    cache "/assets/*" for 30 d     // versioned asset URLs: cache for a month
    cache "/" for 5 m              // the HTML itself: short TTL
    cache "/api/*" never
    requires = [ http3 ]
  }

  service media : media-assets {
    sensitivity = S0
    requires = [ cache, image-resizing ]
  }
}
