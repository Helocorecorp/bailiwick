// Frozen catalog for the conformance suite. Do not edit casually: every
// expected.json / expected.pb depends on it.
//
// FICTIONAL EXAMPLE OFFERS. Not real providers: the vendors are made up
// (vendor-a, vendor-b, ...) and so is every value here, including prices,
// capacity and trust levels. They exist only so the examples and tests have
// something to run against. Countries and subdivisions are real places;
// nothing here says anything about any real provider operating there.
//
// For real decisions, use offers your providers publish, or describe the
// servers you actually run.

offer a-de {
  vendor  = vendor-a
  country = de
  trust   = T2
  classes = [ backend-api, media-assets, background-jobs, database ]
  price   = $0.0198 / vcpu_hour
  resources { vcpu = 16  mem = 32 GB  disk = 320 GB  gpu = 0 }
}

